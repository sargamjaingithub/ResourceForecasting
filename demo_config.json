{
  "data": {
    "source": {
      "name": "google_2019",
      "directory_path": "demo_data",
      "time_feature": "time_stamp",
      "target_feature": "cpu_usage",
      "batch_size": 32,
      "preprocessing_steps": {
        "global": [
          {
            "name": "select_feature_expand",
            "feature": "cpu_usage"
          }
        ],
        "values": [],
        "target": []
      },
      "split": {
        "name": "random",
        "train_size": 0.7,
        "val_size": 0.15
      }
    },
    "type": {
      "name": "full_values_unbiased",
      "shuffle": true,
      "batch_size": 32,
      "lag_size": 24,
      "prediction_size": 1,
      "data_loader": {
        "num_workers": 0,
        "drop_last": false
      },
      "output_visualization": {
        "train_samples": 1,
        "val_samples": 1,
        "test_samples": 1,
        "rate_predictions": 1,
        "initial_color": "#c0e0de",
        "values_color": "gray",
        "target_color": "#3c474b",
        "prediction_color_1": "#4f7cac",
        "prediction_color_2": "#371e30"
      }
    }
  },
  "model": {
    "type": {
      "name": "machine_learning_algorithm"
    },
    "algorithm": {
      "name": "random_forest",
      "args": {
        "n_estimators": 50,
        "min_samples_leaf": 2,
        "max_depth": 10,
        "max_features": 2,
        "criterion": "squared_error",
        "random_state": 0
      }
    }
  },
  "logging": "INFO",
  "save_model": true,
  "save_charts": false,
  "compute_evaluation": false,
  "manual_seed": 0,
  "device": "cpu"
}
